  "dependencies": {
    "@axiomhq/pino": "^2.0.0",
    "@clerk/express": "^2.1.62",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.11",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
