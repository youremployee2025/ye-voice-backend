{
  "name": "ye-voice-backend",
  "version": "1.0.0",
  "description": "API backend for the YE Voice AI platform",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:prepare": "node scripts/test-prepare.mjs",
    "test:ci": "node scripts/ci-test.mjs",
    "conformance": "tsx scripts/conformance/run.ts",
    "battle": "tsx scripts/battle-test.ts",
    "reextract": "tsx scripts/reextract/run.ts",
    "backfill:hangup-source": "tsx scripts/backfill-hangup-source.ts",
    "backfill:end-call-reason": "tsx scripts/backfill-end-call-reason.ts",
    "backfill:session": "tsx scripts/backfill-session-facts.ts",
    "backfill:inbound-call-id": "tsx scripts/backfill-inbound-phone-call-id.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arvind9599/ye-voice-backend.git"
  },
  "keywords": [],
  "author": "",
